{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file",
    "color": {
      "1": "white",
      "2": "bright_black"
    },
    "padding": {
      "top": 1,
      "left": 1
    }
  },
  "display": {
    "separator": " ░ "
  },
  "modules": [
    { "type": "title", "format": "{#37}newerase@system{#}" },
    "separator",
    { "type": "os", "key": "OS      ", "keyColor": "white" },
    { "type": "kernel", "key": "KERNEL  ", "keyColor": "white" },
    { "type": "de", "key": "DESKTOP ", "keyColor": "white" },
    { "type": "terminal", "key": "TERM    ", "keyColor": "white" },
    { "type": "cpu", "key": "CPU     ", "keyColor": "white" },
    { "type": "gpu", "key": "GPU     ", "keyColor": "white" },
    { "type": "memory", "key": "RAM     ", "keyColor": "white" },
    { "type": "uptime", "key": "UPTIME  ", "keyColor": "white" },
    "break",
    { "type": "colors", "symbol": "block" }
  ]
}
